generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ---------- Models ----------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt             DateTime?
  emailVerificationTokenHash  String?
  emailVerificationExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?

  business Business?
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}


model Business {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients  Client[]
  invoices Invoice[]
  recurringInvoices RecurringInvoice[]
  bankAccounts BankAccount[]
withdrawals  Withdrawal[]

  @@map("businesses")
}

model Client {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invoices Invoice[]
  recurringInvoices RecurringInvoice[]

  // The same client email can exist for two different businesses, but not
  // twice for the SAME business.
  @@unique([businessId, email])
  @@index([businessId])
  @@map("clients")
}

model Invoice {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  number   String
  status   InvoiceStatus @default(DRAFT)
  currency String        @default("NGN")

  // All money fields are integers in the smallest unit (kobo). Never floats.
  subtotal       Int
  taxRateBps     Int @default(0)
  taxAmount      Int @default(0)
  discountAmount Int @default(0)
  total          Int

  issueDate DateTime
  dueDate   DateTime
 lastReminderSentAt DateTime?
  publicToken String @unique @default(uuid())

  sentAt      DateTime?
  viewedAt    DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  recurringInvoiceId String?
recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)

  // Invoice numbers (e.g. INV-0001) must be unique per business, not globally.
  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int // kobo
  lineTotal   Int // kobo, quantity * unitPrice, calculated by the server

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                    String        @id @default(uuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount                Int // kobo
  currency              String
  status                PaymentStatus @default(PENDING)
  reference             String        @unique
  providerTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
}

model RecurringInvoice {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  frequency RecurringFrequency
  taxRateBps     Int @default(0)
  discountAmount Int @default(0)

  startDate   DateTime
  nextRunDate DateTime
  endDate     DateTime?
  autoSend    Boolean  @default(false)
  isActive    Boolean  @default(true)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            RecurringInvoiceItem[]
  generatedInvoices Invoice[]

  @@index([businessId])
  @@index([nextRunDate, isActive])
  @@map("recurring_invoices")
}

model RecurringInvoiceItem {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  description        String
  quantity           Int
  unitPrice          Int

  @@map("recurring_invoice_items")
}


enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model BankAccount {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountNumber String
  bankCode      String
  bankName      String
  accountName   String   // resolved from Paystack, never typed by hand
  recipientCode String?  // Paystack transfer recipient code, created lazily on first use
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  withdrawals Withdrawal[]

  @@index([businessId])
  @@map("bank_accounts")
}

model Withdrawal {
  id                  String           @id @default(uuid())
  businessId          String
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankAccountId       String
  bankAccount         BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount              Int              // kobo, always an integer, same rule as everywhere else
  status              WithdrawalStatus @default(PENDING)
  paystackTransferCode String?         @unique
  paystackReference    String          @unique
  failureReason        String?
  createdAt             DateTime       @default(now())
  completedAt            DateTime?

  @@index([businessId])
  @@map("withdrawals")
}